<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Vyooo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>vyooo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.vyooo.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vyooo</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.google.firebase.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-177333950751-ios-9b20ca802bcf0c8b72f82a</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>REVERSED_CLIENT_ID</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.177333950751-4ku8c2nd4643bfamep394q09g1q07fsl</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<!-- Insta360: allow cleartext HTTP to the camera AP (192.168.42.1) and Lightning proxy (localhost:9099). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Vyooo needs the camera to record stories, profile photos, live streams, and video calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone is used for live streaming audio, story videos, voice/video calls, and voice search.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition turns your voice into search text in Vyooo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vyooo needs photo library access to add images to your story and profile.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vyooo uses your location to tag posts with your current place. Location is only accessed when you tap "Use current location".</string>
	<!-- ── Insta360 camera integration ──────────────────────────────────────── -->
	<!-- MFi protocols for USB/Lightning-connected Insta360 cameras (External Accessory framework).
	     TODO(mac): verify this list against the exact camera models you ship for; USB-C X-series
	     support over the iOS SDK's usbManager must be confirmed on-device. -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.insta360.camera</string>
		<string>com.insta360.onecontrol</string>
		<string>com.insta360.onexcontrol</string>
		<string>com.insta360.onex2control</string>
		<string>com.insta360.onercontrol</string>
		<string>com.insta360.nanoscontrol</string>
	</array>
	<!-- Local Network permission (iOS 14+): required to reach the camera's Wi-Fi AP at 192.168.42.1. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vyooo connects to your Insta360 camera over its Wi-Fi network to stream the 360 preview.</string>
	<!-- Bluetooth is used by the SDK to wake/pair some Insta360 models. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Vyooo uses Bluetooth to connect to and control your Insta360 camera.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- Insta360: keep the External Accessory session alive while the app is backgrounded during capture. -->
		<string>external-accessory</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
