# Firebase requires iOS 12+. Uncomment to set explicitly.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Static linkage avoids dynamic-framework + FFI edge cases (Agora Iris / DartWorker crashes on device).
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# RevenueCat 5.68 (purchases_flutter 10.0.1) declares PaywallColor's designated
# initializer in an extension. Xcode 27 then synthesizes
# `init(stringRepresentation:)` and rejects the public initializer as a
# redeclaration. RevenueCat fixed this in 5.78 by declaring that initializer
# on the struct itself, which suppresses memberwise synthesis.
def patch_revenuecat_paywall_color_for_xcode_27(installer)
  file = File.join(installer.sandbox.root.to_s, 'RevenueCat', 'Sources', 'Paywalls', 'PaywallColor.swift')
  return unless File.exist?(file)

  contents = File.read(file)
  public_mark = contents.index('// MARK: - Public constructors')
  designated = 'private init(stringRepresentation: String, underlyingColor:'
  designated_at = contents.index(designated)
  return if public_mark && designated_at && designated_at < public_mark

  old_init = [
    '    /// "Designated" initializer',
    '    private init(stringRepresentation: String, underlyingColor: (any Sendable)?) {',
    '        self.stringRepresentation = stringRepresentation',
    '        self._underlyingColor = underlyingColor',
    '    }',
    '',
  ].join("\n")
  new_init = [
    '    /// "Designated" initializer',
    '    /// Declared on the type so Xcode 27 does not synthesize a memberwise',
    '    /// `init(stringRepresentation:)` that collides with the public initializer.',
    '    private init(stringRepresentation: String, underlyingColor: (any Sendable)?) {',
    '        self.stringRepresentation = stringRepresentation',
    '        self._underlyingColor = underlyingColor',
    '    }',
    '',
  ].join("\n")
  property = "    fileprivate var _underlyingColor: (any Sendable)?\n\n"

  unless contents.include?(property) && contents.include?(old_init)
    Pod::UI.warn('RevenueCat PaywallColor.swift layout changed; Xcode 27 initializer patch was not applied.')
    return
  end

  contents = contents.sub(property, property + new_init)
  contents = contents.sub(old_init, '')
  File.chmod(0o644, file)
  File.write(file, contents)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Some plugins (e.g. purchases_flutter/PurchasesHybridCommon) require
      # a higher minimum deployment target than older lockfile snapshots.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
      ]
    end
  end

  patch_revenuecat_paywall_color_for_xcode_27(installer)
end
